{
    "root": {
	"model": "efinix,sapphire",
        "includes": [
	    "#include <dt-bindings/gpio/gpio.h>",
	    "#include <dt-bindings/interrupt-controller/irq.h>"
	]
    },
    "drivers": {
	"cpu": {
	    "compatible": "riscv",
	    "private_data": [
	        "tlb-split;"
	    ],
	    "child": {
		"device_type": "interrupt_controller",
	        "interrupt_controller": true,
		"interrupt_cells": 1,
		"compatible": "riscv,cpu-intc"
	    }
	},
        "spi": {
	    "compatible": ["spinal-lib,spi-1.0"],
	    "private_data": [
	        "cmd_fifo_depth = <256>;",
		"rsp_fifo_depth = <256>;",
		"num-cs = <1>;"
	    ]
	},
	"uart": {
	    "compatible": ["spinal-lib,uart-2.0"],
	    "private_data": [
	        "current-speed = <115200>;"
	    ]
	},
	"gpio": {
	    "compatible": ["spinal-lib,gpio-1.0"],
	    "interrupt_cells": 2,
	    "private_data": [
		"#gpio-cells = <2>;",
	    	"ngpio = <4>;",
		"gpio-controller;"
	    ]
	},
	"i2c": {
	    "compatible": ["efinix,efx-i2c"],
	    "clock_frequency": "100000"
	},
	"plic": {
	    "compatible": ["sifive,plic-1.0.0", "sifive,fu540-c000-plic"],
	    "interrupts_extended": [11, 9],
	    "label": "plic",
	    "interrupt_controller": true,
	    "_device_type_": "interrupt-controller",
	    "interrupt_cells": 1,
	    "private_data": [
		"riscv,ndev = <32>;"
	    ],
	    "status": "okay"
	},
	"axi": {
	    "compatible": ["simple-bus"]
	},
	"bmb": {
	    "compatible": ["simple-bus"]
	},
	"peripheral": {
	    "compatible": ["simple-bus"]
	},
	"platform": {
	    "compatible": ["simple-bus"]
	},
	"watchdog": {
	    "compatible": ["efx,efx-wdt"]
	},
	"clint": {
	    "compatible": ["riscv,clint0"],
	    "interrupts_extended": [3, 7],
	    "status": "disabled"
	}
    },
    "child": {
        "chosen": {
            "parent_label": "root",
            "header": "chosen",
	    "stdout_path": "serial0:115200n8",
	    "bootargs": "rootwait console=ttySL0 earlycon root=/dev/mmcblk0p2 init=/sbin/init mmc_core.use_spi_crc=0"
        },
	"aliases": {
	    "parent_label": "root",
	    "header": "aliases",
	    "private_data": [
	        "serial0 = &uart0;"
	    ]
	}
    },
    "custom": {
	"clock": {
	    "device_instance": "custom0",
	    "device_type": "clock",
	    "label": "clock",
	    "interface": "clock",
	    "reg": null,
	    "compatible": "fixed-clock",
	    "private_data": [
	        "#clock-cells = <0>;"
	    ],
	    "dtsi": true
	}
    }
}

