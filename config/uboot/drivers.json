{
    "root": {
        "model": "efinix,sapphire",
        "includes": [
            "#include <config.h>"
        ]
    },
    "drivers": {
        "cpu": {
            "compatible": "riscv",
	    "private_data": [
	        "tlb-split;"
	    ],
	    "child": {
	        "device_type": "interrupt_controller",
		"interrupt_controller": true,
		"interrupt_cells": 1,
		"compatible": "riscv,cpu-intc"
	    }
        },
        "spi": {
            "compatible": ["vexriscv,spi"]
        },
        "uart": {
            "compatible": ["riscv_sbi,uart"],
            "device_type": "serial"
        },
        "plic": {
	    "addr_cells": 0,
	    "label": "plic",
	    "device_type": "interrupt-controller",
	    "compatible": ["sifive,plic-1.0.0"],
	    "interrupts_extended": [11],
	    "interrupt_controller": true,
	    "private_data": [
		"#interrupt-cells = <2>;",
		"riscv,ndev = <32>;"
	    ],
	    "status": "okay"
        },
	"axi": {
	    "compatible": ["simple-bus"]
	},
	"bmb": {
	    "compatible": ["simple-bus"]
	},
	"peripheral": {
	    "compatible": ["simple-bus"]
	},
	"platform": {
	    "compatible": ["simple-bus"]
	},
	"watchdog": {
	    "compatible": ["efx,efx-wdt"]
	},
	"clint": {
	    "compatible": ["riscv,clint0"],
	    "interrupts_extended": [3, 7]
	}
    },
    "child": {
        "chosen": {
	    "parent_label": "root",
	    "header": "chosen",
	    "stdout_path": "serial0:115200n8",
	    "bootargs": "console=ttyS0,115200n8"
	},
	"aliases": {
	    "parent_label": "root",
	    "header": "aliases",
	    "private_data": [
	        "serial0 = &uart0;"
	    ]
	}
    }
}
