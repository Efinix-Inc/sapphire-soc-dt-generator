{%- import 'node.jinja2' as macros -%}
{{ root.version }};
{%- if root.includes %}
{%- for inc in root.includes %}
{{ inc }}
{%- endfor %}
{%- endif %}

{{ root.header }} {
	#address-cells = <{{ root.address_cells }}>;
	#size-cells = <{{ root.size_cells }}>;
	{%- if root.model %}
	model = "{{ root.model }}";
	{%- endif %}

	{% set mem = root.memory %}
	{{ mem.header }} {
		device_type = "{{ mem.device_type }}";
		reg = <{{ mem.reg }}>;
	};

	{%- if child %}
	{%- for ck, cv in child.items() %}
	{%- if cv.parent_label == "/" %}
	{{ macros.render_device(cv) | indent(8, False) }}
	{%- endif %}
	{%- endfor %}
	{% endif %}
};

{%- for bus_type, bus_val in buses.items() %}
{%- if bus_val.peripherals %}
{%- set peripherals = bus_val.peripherals %}
{%- for pk, pv in peripherals.items() %}
{%- if pv.status != "okay" %}
&{{ pv.label }} {
	{%- if pv.address_cells %}
	#address-cells = <{{ pv.address_cells }}>;
	{%- endif %}
	{%- if pv.size_cells or pv.size_cells == 0 %}
	#size-cells = <{{ pv.size_cells }}>;
	{%- endif %}
	{%- if pv.private_data %}
	{%- for priv_data in pv.private_data %}
	{{ priv_data }}
	{%- endfor %}
	{%- endif %}
	status = "okay";

	{%- if child %}
	{%- for ck, cv in child.items() %}
	{%- if cv.parent_label == pk %}
	{{ macros.render_device(cv) | indent(8, False) }}
	{%- endif %}
	{%- endfor %}
	{%- endif %}
};
{% endif %}
{%- endfor %}
{%- endif %}
{% endfor %}
