{%- import 'custom_node.jinja2' as custom_macros %}
{{ root.version }};

{{ root.header }} {
	#address-cells = <{{ root.address_cells }}>;
	#size-cells = <{{ root.size_cells }}>;
	
	cpus {
		#address-cells = <{{ root.cpus.cpu0.address_cells }}>;
		#size-cells = <{{ root.cpus.cpu0.size_cells }}>;
		timebase-frequency = <{{ root.frequency }}>;
		{% for k, v in root.cpus.items() %}
		{{ v.header }} {
			reg = <{{ v.reg }}>;
			{%- if v.compatible_str %}
			compatible = {{ v.compatible_str }};
			{%- endif %}
			device_type = "{{ v.device_type }}";
			riscv,isa = "{{ v.isa }}";
			{%- if root.cpu_name %}
			cpu-name = "{{ root.cpu_name }}";
			{%- endif %}
			{%- if root.board_name %}
			board = "{{ root.board_name }}";
			{%- endif %}
			mmu_type = "{{ v.mmu_type }}";
			i-cache-size = <{{ v.icache_size }}>;
			i-cache-sets = <{{ v.icache_ways }}>;
			i-cache-block-size = <{{ v.bytes_per_line }}>;
			d-cache-size = <{{ v.dcache_size }}>;
			d-cache-sets = <{{ v.dcache_ways }}>;
			d-cache-block-size = <{{ v.bytes_per_line }}>;
			{%- if v.l2_cache_ways %}
			l2-cache-ways = <{{ v.l2_cache_ways }}>;
			{%- endif %}
			{%- if v.l2_cache_size %}
			l2-cache-size = <{{ v.l2_cache_size }}>;
			{%- endif %}
			{%- if v.zicbom_cache %}
			riscv,cbom-block-size = <{{ v.bytes_per_line }}>;
			{%- endif %}
			{%- if v.private_data %}
			{%- for priv_data in v.private_data %}
			{{ priv_data }}
			{%- endfor %}
			{%- endif %}
			status = "{{ v.status }}";
			{% if v.child %}
			{%- set irq_ctrl = v.child %}
			{{ irq_ctrl.header }} {
				#interrupt-cells = <{{ irq_ctrl.interrupt_cells }}>;
				{%- if irq_ctrl.interrupt_controller %}
				interrupt-controller;
				{%- endif %}
				compatible = "{{ irq_ctrl.compatible }}";
			};
			{%- endif %}
		};
		{% endfor %}
	};

	{%- for ck, cv in custom.items() %}
	{%- if cv.dtsi == true %}
	{{ custom_macros.custom_node(custom) | indent(8, False) }}
	{%- endif %}
	{%- endfor %}

	{% for bus_type, bus_val in buses.items() %}
	{%- if bus_val.peripherals %}
	{{ bus_val.header }} {
		#address-cells = <{{ bus_val.address_cells }}>;
		#size-cells = <{{ bus_val.size_cells }}>;
		{%- if bus_val.compatible_str %}
		compatible = {{ bus_val.compatible_str }};
		{%- endif %}
		ranges = <{{ bus_val.ranges }}>;
		{% set peripherals = bus_val.peripherals %}
		{%- for pk, pv in peripherals.items() %}
		{{ pv.header }} {
			{%- if pv.interrupt_cells or pv.interrupt_cells == 0 %}
			#interrupt-cells = <{{ pv.interrupt_cells }}>;
			{%- endif %}
			reg = <{{ pv.reg }}>;
			{%- if pv.compatible_str %}
			compatible = {{ pv.compatible_str }};
			{%- endif -%}
			{%- if pv.interrupt_controller %}
			interrupt-controller;
			{%- endif %}
			{%- if pv.interrupts %}
			interrupts = <{{ ' '.join(pv.interrupts) }}>;
			{%- if pv.interrupt_parent %}
			interrupt-parent = <{{ pv.interrupt_parent }}>;
			{%- endif %}
			{%- endif %}
			{%- if pv.irq_extended %}
			interrupts-extended = <{{ pv.irq_extended }}>;
			{%- endif %}
			{%- if pv.clocks %}
			clocks = <{{ pv.clocks }}>;
			clock-frequency = <{{ pv.clock_frequency }}>;
			{%- endif %}
			status = "disabled";
		};
		{% endfor %}
	};
	{% endif %}
	{%- endfor %}
};
